# ---------------------------------------------------------------------------
# STEM & BUDS — environment variables
# Copy this file to `.env.local` and fill in real values for your machine.
# Never commit `.env.local` or any file containing real secrets.
# ---------------------------------------------------------------------------

# --- Database ---------------------------------------------------------------
# PostgreSQL connection string used by the app and by migrations. Any
# standard Postgres connection string works (the driver is postgres-js).
#
# Local Postgres:
DATABASE_URL=postgresql://USER:PASSWORD@127.0.0.1:5432/stembuds_dev
#
# Supabase: use the project's transaction-mode pooler connection string
# (Project Settings -> Database -> Connection string -> "Transaction" mode,
# port 6543). The app already passes `prepare: false`, which that pooler
# requires. If `npm run db:migrate` ever fails against the pooler (advisory
# locks aren't available in transaction mode), point DATABASE_URL at the
# same project's direct/session connection (port 5432) instead — safe for
# this app either way, since it runs as one persistent server, not
# serverless functions.
# DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres

# Separate database used by the automated integration test suite.
# It is created/migrated/truncated by the test runner and must never point at
# development or production data.
TEST_DATABASE_URL=postgresql://USER:PASSWORD@127.0.0.1:5432/stembuds_test

# --- Application ------------------------------------------------------------
# Public base URL of the deployment (used in emails and absolute links).
APP_URL=http://localhost:3000
# IANA timezone used for scheduling and Turkish date formatting.
APP_TIMEZONE=Europe/Istanbul
# Name of the session cookie.
SESSION_COOKIE_NAME=sb_session
# Set to "true" only when serving over HTTPS (forces the Secure cookie flag).
SESSION_COOKIE_SECURE=false

# --- First executive bootstrap ----------------------------------------------
# Shared secret required by `npm run bootstrap:executive`. Leave unset in
# development; set it in production so the bootstrap cannot be run casually.
BOOTSTRAP_TOKEN=

# --- Background job runner ---------------------------------------------------
# Bearer token required by POST /api/jobs/run so an external scheduler
# (cron, Vercel Cron, GitHub Actions...) can trigger scheduled work.
JOB_RUNNER_TOKEN=
# Vercel automatically sends this value as `Authorization: Bearer ...` when
# invoking a configured Cron path. Use a long random value in production.
CRON_SECRET=

# --- E-mail ------------------------------------------------------------------
# "mock"  -> nothing is sent; every message is recorded in the email log with
#            the result "skipped" and a clear reason. This is the default.
# "smtp"  -> real delivery through the SMTP settings below.
EMAIL_TRANSPORT=mock
EMAIL_FROM_NAME=STEM & BUDS
EMAIL_FROM_ADDRESS=stemandbuds01@gmail.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
# For Gmail this must be a Google App Password, never the account password.
SMTP_PASSWORD=

# --- Private file storage -----------------------------------------------------
# Local development and tests use the filesystem. Vercel production must use
# Supabase because a Vercel Function's local filesystem is not persistent.
STORAGE_BACKEND=filesystem
UPLOAD_DIR=./storage
# Required only when STORAGE_BACKEND=supabase. Use the Project URL and a
# server-side Secret key (`sb_secret_...`) from Supabase Settings > API Keys.
# Never expose the Secret key in client code or a NEXT_PUBLIC_* variable.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
SUPABASE_STORAGE_BUCKET=stem-buds-private

# --- First Vercel deployment only --------------------------------------------
# The Vercel build creates the first Executive only when the database has no
# Executive account. Remove these four variables from Vercel after first login.
INITIAL_EXECUTIVE_USERNAME=
INITIAL_EXECUTIVE_NAME=
INITIAL_EXECUTIVE_PASSWORD=
INITIAL_EXECUTIVE_EMAIL=

# --- Phase 5 management AI (Groq) --------------------------------------------
# Server-only. Never exposed to the client bundle, never logged. Leave unset
# to run with AI surfaces gracefully disabled — deterministic alerts and all
# other product features are unaffected.
GROQ_API_KEY=
